# BANANA CLIPS AI STUDIO — Backend API (NestJS + FFmpeg)
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y ffmpeg python3 curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY packages ./packages
COPY workers ./workers
COPY apps/api ./apps/api

RUN npm install
RUN npm --workspace=@banana/api run build

EXPOSE 4000
WORKDIR /app/apps/api
CMD ["node", "dist/main.js"]
