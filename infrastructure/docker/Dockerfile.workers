# BANANA CLIPS AI STUDIO — Distributed Workers (Ingest, Transcribe, Analyze, Render)
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y ffmpeg python3 python3-pip curl ca-certificates yt-dlp && rm -rf /var/lib/apt/lists/*

COPY package.json ./
COPY packages ./packages
COPY workers ./workers

RUN npm install
RUN npm --workspace=@banana/workers run build

WORKDIR /app/workers
CMD ["node", "dist/worker-entry.js"]
