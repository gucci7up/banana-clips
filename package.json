{
  "name": "banana-clips-ai-studio",
  "version": "1.0.0",
  "private": true,
  "description": "BANANA CLIPS AI STUDIO — Private AI Video Clipping, Reframing, Subtitling, Semantic Search & Editing Platform (Coolify & Dokploy ready)",
  "scripts": {
    "build": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:workers": "tsx workers/src/worker-entry.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "test:integration": "tsx tests/integration/run-integration-tests.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@napi-rs/canvas": "^0.1.100",
    "@tanstack/react-query": "^5.60.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "next": "^15.0.3",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
