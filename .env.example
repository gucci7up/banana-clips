# =============================================================================
# BANANA CLIPS AI STUDIO — ENVIRONMENT CONFIGURATION (.env.example)
# Private AI Clipping Platform deployed & managed via Dokploy
# =============================================================================

# --- General Environment ---
NODE_ENV=production
APP_NAME="BANANA CLIPS AI STUDIO"
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
PUBLIC_APP_URL=https://clips.tudominio.local
PUBLIC_API_URL=https://api.clips.tudominio.local/api/v1
CORS_ORIGIN=https://clips.tudominio.local

# --- Initial Administrator Bootstrap (SUPER_ADMIN) ---
# IMPORTANT: Change these values before first deployment.
# Bootstrap is idempotent and will NEVER overwrite existing credentials on restart.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bananaclips.local
ADMIN_INITIAL_PASSWORD=ChangeMe_BananaStudio_2026!
ADMIN_FULL_NAME="Propietario Banana Clips"

# --- Authentication & Security (Argon2id + Rotating JWT) ---
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_access_secret_key_01
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_refresh_secret_key_02
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_32_byte_cookie_secret_key
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=bananaclips
POSTGRES_PASSWORD=bananaclips_pg_secret_password
POSTGRES_DB=bananaclips_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bananaclips:bananaclips_pg_secret_password@postgres:5432/bananaclips_db?schema=public
# Set Embedded PGlite fallback only when running bare-metal local tests without Docker:
USE_EMBEDDED_DB=false
EMBEDDED_DB_PATH=./.local-data/pgdata

# --- Redis & BullMQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=bananaclips_redis_secret
REDIS_URL=redis://:bananaclips_redis_secret@redis:6379/0
USE_EMBEDDED_QUEUE=false

# --- MinIO S3 Object Storage ---
MINIO_ROOT_USER=bananaclips_minio
MINIO_ROOT_PASSWORD=bananaclips_minio_secret_key
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_VIDEOS=banana-videos
MINIO_BUCKET_CLIPS=banana-clips
MINIO_BUCKET_PREVIEWS=banana-previews
MINIO_BUCKET_THUMBNAILS=banana-thumbnails
MINIO_BUCKET_MODELS=banana-models
MINIO_BUCKET_EXPORTS=banana-exports
SIGNED_URL_TTL_SECONDS=3600
USE_LOCAL_FS_STORAGE=false
LOCAL_STORAGE_PATH=./.local-data/storage

# --- Python AI & Multimedia Microservice ---
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_INTERNAL_TOKEN=banana_internal_ai_service_token_secret

# --- Hardware Profile & AI Models ---
# Options: CPU_ONLY | NVIDIA_LOW_VRAM | NVIDIA_HIGH_VRAM | AUTO
HARDWARE_PROFILE=AUTO
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELS_CACHE_DIR=/data/models
UNLOAD_MODELS_AFTER_JOB=true
MAX_CONCURRENT_TRANSCRIBE_JOBS=1
MAX_CONCURRENT_RENDER_JOBS=2

# --- Resource Control Defaults (Private Multi-User Quotas) ---
DEFAULT_MAX_CONCURRENT_JOBS_PER_USER=2
DEFAULT_MAX_FILE_SIZE_MB=4096
DEFAULT_MAX_VIDEO_DURATION_SECONDS=14400
DEFAULT_MAX_STORAGE_GB_PER_USER=50
DEFAULT_MAX_QUEUED_VIDEOS_PER_USER=10
